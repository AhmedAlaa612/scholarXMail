SUPABASE_URL= 
SUPABASE_SERVICE_ROLE_KEY= 

# Optional: path to JSON file with many sender accounts
# Example: ./smtp-profiles.local.json
SMTP_PROFILES_FILE=

# Optional: JSON string with all sender profiles (best for Vercel)
# Example: {"gmail":{"host":"smtp.gmail.com","port":587,"user":"...","pass":"...","from":"ScholarX <...>"}}
SMTP_PROFILES_JSON=

# Default profile (gmail) - backward compatible names
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ScholarX <scholarx.team@gmail.com>"

# Optional explicit gmail profile names
SMTP_PROFILE_GMAIL_HOST=smtp.gmail.com
SMTP_PROFILE_GMAIL_PORT=587
SMTP_PROFILE_GMAIL_USER=
SMTP_PROFILE_GMAIL_PASS=
SMTP_PROFILE_GMAIL_FROM="ScholarX <scholarx.team@gmail.com>"

# Info profile (Hostinger)
SMTP_INFO_HOST=smtp.hostinger.com
SMTP_INFO_PORT=465
SMTP_INFO_USER=info@scholar-x.org
SMTP_INFO_PASS=
SMTP_INFO_FROM="ScholarX <info@scholar-x.org>"
